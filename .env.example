# Frontend Server Port
PORT=8081

# Backend Base API URL (used by Flutter Web client)
BACKEND_BASE_URL=http://localhost:8080/api/v1

# Google OAuth Web Client ID (from Google Cloud Console, must have this
# server's origin in "Authorized JavaScript origins"). Leave blank to hide
# the Google sign-in button. Must match the BE's GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
